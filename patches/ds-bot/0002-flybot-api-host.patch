+          reason: { type: 'string', description: 'One line on why you could not finish it.' },
+          retryInSec: { type: 'integer', description: 'Seconds before the item is offered again. Defaults to 60.' },
+        },
+        additionalProperties: false,
+      },
+      tasks: {
+        type: 'array',
+        description: 'Tasks to create or update. Omit to read your list.',
+        items: {
+          type: 'object',
+          additionalProperties: false,
+          properties: {
+            id: { type: 'string', description: 'Existing task id. Omit to match an open task by title, or to create one.' },
+            title: { type: 'string', description: 'Short name of the work. Required when creating.' },
+            column: { type: 'string', enum: ['not-started', 'in-progress', 'done'], description: 'Board column.' },
+            progress: { type: 'integer', description: 'How far along, from 0 to 100.' },
+            priority: { type: 'string', enum: ['low', 'normal', 'high', 'urgent'], description: 'How urgent the task is.' },
+            note: { type: 'string', description: 'One line on where the task stands.' },
+            group: { type: 'string', description: 'Group chat name this task belongs to. In a group, the current group is used when this is omitted.' },
+            overall: { type: 'boolean', description: 'Record this as the group\'s one overall task. Only the room\'s task lead may set it (the group admin, when no lead is picked). A later call updates that same open task.' },
+            parent: { type: 'string', description: 'Id or title of the overall group task this subtask belongs to.' },
+            assignee: { type: 'string', description: 'Name of the Bot that owns this subtask. Only the room\'s task lead may name another member. The card is claimed, and that Bot starts the work without waiting for a confirmation.' },
+            queue: { type: 'boolean', description: 'Enqueue this item for a role instead of naming an assignee. Only the room\'s task lead may enqueue. Pass role with it: the item belongs to the room until a member of that role claims it, and enqueuing wakes one idle member of that role.' },
+            role: { type: 'string', description: 'The role a queued item is for: the Bot role label, matched case-insensitively. It is not a group membership role.' },
+            ask: { type: 'string', description: 'The question you need before this task can continue. The task waits. Call ask_user in your own chat. For a group card, post one short question in the group only when a person has to decide.' },
+            answer: { type: 'string', description: 'What the user or the group answered. Pass it to resume a task that was waiting.' },
+            target: { type: 'string', description: 'Where a decision on this task is written back: a GitHub issue or pull request, as https://github.com/owner/repo/issues/12 or owner/repo#12. Optional.' },
+            postResult: {
+              type: 'object',
+              description: 'How the decision comment a task asked you to post went. Pass task (its id) and ok; when ok is false, pass the error. One report per decision, and no retrying on its own.',
+              properties: {
+                task: { type: 'string', description: 'The task id the comment belongs to.' },
+                ok: { type: 'boolean', description: 'Whether the comment was posted.' },
+                error: { type: 'string', description: 'Why it failed, one line. Required when ok is false.' },
+              },
+              additionalProperties: false,
+            },
+          },
+        },
+      },
+    },
+    output,
+    async execute(args, exec) {
+      await rt.load()
+      const self = rt.selfOf(exec.agent?.id)
+      if (!rt.botOf(self)) return 'Only a Bot on the team can track tasks.'
+      const roomId = rt.groupOwners.get(exec.agent?.id)?.roomId
+      try {
+        if (args?.postResult !== undefined) await rt.recordTaskPostResult(self, args.postResult)
+        // A claim arrives with tasks omitted, so it is taken before the read path (#1247).
+        if (args?.claim === true) {
+          const result = await rt.trackBotTasks(self, args ?? {}, { sessionId: exec.agent?.id, roomId })
+          if (result?.item) {
+            return `Claimed ${result.item.id} [${result.item.priority ?? 'normal'}] ${result.item.title}\nSet its column to in-progress with track_tasks as you start, and update its note as it moves. Do not post a status in the group.`
+          }
+          const role = rt.botOf(self)?.role ?? ''
+          const why = result?.reason === 'wip' ? ` You already hold an in-progress card (${result.held}).` : ''
+          return `No queued item for ${role === '' ? 'your role' : role} right now.${why}`
+        }
+        if (args?.release !== undefined) {
+          const returned = await rt.trackBotTasks(self, args ?? {}, { sessionId: exec.agent?.id, roomId })
+          const seconds = Math.max(0, Math.round(((returned.retryAt ?? 0) - Date.now()) / 1000))
+          return `Returned ${returned.id} to the queue: ${returned.queueReason}. Not offered again for ${seconds} s.`
+        }
+        const tasks = await rt.trackBotTasks(self, args ?? {}, { sessionId: exec.agent?.id, roomId })
+        if (!Array.isArray(tasks) || tasks.length === 0) return 'No tasks.'
+        return formatTasks(tasks, { inGroup: Boolean(roomId), withNext: args?.tasks === undefined })
+      } catch (error) {
+        return error?.message ?? String(error)
+      }
+    },
+  }))
+
   Object.assign(rt, { pickRoom, hideBlockingQuestion })
 }
