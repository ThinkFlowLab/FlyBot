+  assert.equal(removed.length, 1)
+  assert.equal(removed[0].botId, id)
+  assert.equal(removed[0].listed, false)
+  assert.deepEqual(removed[0].bot.fields, { tree: { parent: null, treeRole: 'top' } })
+  assert.equal(changes.length, before)
+})
