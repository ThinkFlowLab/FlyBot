+  assert.deepEqual(tree.bot.fields.query('parent', 'a').map(b => b.id), ['b', 'c'])
+  assert.deepEqual(seen[0], { botId: 'b', plugin: 'tree', key: 'parent', value: 'a', prev: undefined })
