+  state.connectors = { feishu: { mode: 'app', appId: 'cli_app_1', allowed: [{ openId: 'ou_owner_1' }] } }
+  writeFileSync(join(home, 'state.json'), JSON.stringify(state))
+  writeFileSync(join(home, 'secrets.json'), JSON.stringify({
