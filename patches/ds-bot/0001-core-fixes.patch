+// A test's temp home can still be written by a background save that outlives dispose(), so a
+// plain rmSync sometimes raced and failed the whole run with ENOTEMPTY (a flaky verify/CI). Settle
+// and retry; if it is still racing, leave the temp dir — the test's assertions already passed.
+async function cleanHome(home, remove = rmSync) {
+  for (let attempt = 0; attempt < 5; attempt++) {
+    try {
+      remove(home, { recursive: true, force: true, maxRetries: 5, retryDelay: 20 })
+      return
+    } catch (error) {
+      if (error?.code !== 'ENOTEMPTY' && error?.code !== 'EBUSY' && error?.code !== 'ENOENT') throw error
+      await new Promise(resolve => setTimeout(resolve, 50))
+    }
+  }
+}
+
+// #532: the cleanup itself is what has to be stable, so pin its contract — a racing save is waited
+// out, a directory that never settles is left behind instead of failing the run, and any other
+// error still surfaces.
+test('the cleanup waits out a racing save and leaves a directory that never settles', async () => {
+  const tries = []
+  await cleanHome('ignored', () => {
+    tries.push(1)
+    if (tries.length < 3) throw Object.assign(new Error('directory not empty'), { code: 'ENOTEMPTY' })
+  })
+  assert.equal(tries.length, 3, 'it settles after the third try')
+  tries.length = 0
+  await cleanHome('ignored', () => {
+    tries.push(1)
+    throw Object.assign(new Error('still racing'), { code: 'EBUSY' })
+  })
+  assert.equal(tries.length, 5, 'it gives up quietly after five tries')
+  await assert.rejects(cleanHome('ignored', () => { throw Object.assign(new Error('denied'), { code: 'EACCES' }) }), /denied/)
