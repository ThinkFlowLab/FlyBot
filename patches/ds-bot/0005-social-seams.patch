+        try { attempt(left - 1) } catch (failure) { warn('ds-bot: could not register %s: %s', route.path, failure) }
+      }, every)
+      timer.unref?.()
+    }
+  }
+  attempt(tries)
+  return () => {
+    stopped = true
+    clearTimeout(timer)
+    dispose?.()
+  }
+}
